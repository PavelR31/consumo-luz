# Database - SQLite for dev, MySQL for prod
# DEV:
DATABASE_URL=sqlite:///./consumo_luz.db
# PROD (uncomment and configure):
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/consumo_luz

# Auth
SECRET_KEY=change-this-to-a-random-secret-key-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_ALLOWED_USERS=123456789,987654321

# App
APP_HOST=0.0.0.0
APP_PORT=8000
UPLOAD_DIR=./uploads
